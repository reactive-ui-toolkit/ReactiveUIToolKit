{
  "name": "ReactiveUITK.Ugui.Tests",
  "references": [
    "UnityEngine.TestRunner",
    "UnityEditor.TestRunner",
    "ReactiveUITK.Shared",
    "ReactiveUITK.Runtime",
    "ReactiveUITK.Ugui",
    "UnityEngine.UI",
    "Unity.TextMeshPro"
  ],
  "includePlatforms": [
    "Editor"
  ],
  "excludePlatforms": [],
  "allowUnsafeCode": false,
  "overrideReferences": true,
  "precompiledReferences": [
    "nunit.framework.dll"
  ],
  "autoReferenced": false,
  "defineConstraints": [
    "UNITY_INCLUDE_TESTS",
    "REACTIVEUITK_HAS_TEST_FRAMEWORK"
  ],
  "versionDefines": [
    {
      "name": "com.unity.test-framework",
      "expression": "1",
      "define": "REACTIVEUITK_HAS_TEST_FRAMEWORK"
    }
  ],
  "noEngineReferences": false
}

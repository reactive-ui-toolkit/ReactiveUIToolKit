export VirtualNode PanelHelloFunc() {
  var (count, setCount) = useState(0);

  var containerStyle = new Style {
    (StyleKeys.Padding, 16f),
    (StyleKeys.FlexDirection, "column"),
  };

  return (
    <VisualElement style={containerStyle}>
      <Text text="Hello PanelRenderer" />
      <Text
        text="This tree mounted through RootRenderer.Initialize(PanelRenderer): the panel is built by Unity a frame after enable, so the first Render was deferred and replayed automatically."
      />
      <Text text={$"Clicks: {count}"} />
      <Button text="Click me" onClick={_ => setCount(count + 1)} />
    </VisualElement>
  );
}
